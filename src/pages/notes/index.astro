---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getPublished } from '../../lib';

const entries = await getPublished('notes');
---
<Base title="Lernnotizen">
  <h1>Lernnotizen</h1>
  <p class="muted">Zusammenfassungen aus meiner Weiterbildung, Kursen und Büchern.</p>
  {entries.length === 0 ? <p>Noch nichts hier.</p> : (
    <ul class="card-list">{entries.map((e) => <EntryCard entry={e} />)}</ul>
  )}
</Base>
